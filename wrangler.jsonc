{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layrton-dev",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  // www.layrton.dev, layrton.com.br and www.layrton.com.br 301 here via zone Redirect Rules
  "routes": [{ "pattern": "layrton.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
