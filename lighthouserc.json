{
  "ci": {
    "collect": {
      "startServerCommand": "npx wrangler dev --port 8787",
      "startServerReadyPattern": "Ready on",
      "url": ["http://localhost:8787/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "resource-summary:script:count": ["error", { "maxNumericValue": 0 }],
        "resource-summary:font:count": ["error", { "maxNumericValue": 0 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 10240 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
